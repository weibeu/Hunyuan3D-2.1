# Dockerfile for RunPod Serverless Deployment
# Hunyuan3D-2.1 Model

FROM nvidia/cuda:12.1.0-cudnn8-devel-ubuntu22.04

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV CUDA_HOME=/usr/local/cuda
ENV PATH="${CUDA_HOME}/bin:${PATH}"
ENV LD_LIBRARY_PATH="${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}"
ENV DISPLAY=:99

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3-pip \
    git \
    wget \
    curl \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libxi6 \
    libxrandr2 \
    libxfixes3 \
    libxcursor1 \
    libxinerama1 \
    libxxf86vm1 \
    xvfb \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements and install Python dependencies
COPY requirements.txt .

# Install PyTorch with CUDA support first
RUN pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121

# Install packages from requirements.txt (with version adjustments for PyPI availability)
RUN pip install --no-cache-dir -r requirements.txt

RUN pip install bpy==4.0 --extra-index-url https://download.blender.org/pypi/ && \
    python3 -c "import sys; print('Testing bpy import with virtual display...', file=sys.stderr)" && \
    Xvfb :99 -screen 0 1024x768x24 > /dev/null 2>&1 & \
    sleep 2 && \
    DISPLAY=:99 python3 -c "import bpy; print(f'✓ bpy {bpy.app.version_string} imported successfully', file=sys.stderr)" && \
    pkill Xvfb 

# Install packages not available on official PyPI using mirrors
# tb_nightly from Tencent mirror
RUN pip install --no-cache-dir \
    --extra-index-url https://mirrors.cloud.tencent.com/pypi/simple/ \
    tb_nightly==2.18.0a20240726

# cupy-cuda12x from NVIDIA PyPI
RUN pip install --no-cache-dir \
    --extra-index-url https://pypi.nvidia.com \
    cupy-cuda12x==13.4.1

# Install RunPod SDK
RUN pip install --no-cache-dir runpod

# Copy application code
COPY . .

# Create output directory
RUN mkdir -p /runpod-volume/outputs

# Set environment variables for RunPod
ENV SAVE_DIR=/runpod-volume/outputs
ENV MODEL_PATH=tencent/Hunyuan3D-2.1
ENV SUBFOLDER=hunyuan3d-dit-v2-1

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD python3 -c "import torch; print(torch.cuda.is_available())" || exit 1

# Start Xvfb and RunPod handler
CMD ["/bin/bash", "-c", "Xvfb :99 -screen 0 1024x768x24 > /dev/null 2>&1 & sleep 1 && python3 -u rp_handler.py"]
